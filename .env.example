# Copy to .env and fill in. Never commit .env. Never put a real key here.
#
# Set one key, or both. The app runs on Google Gemini or Meta Muse.
GEMINI_API_KEY=your-gemini-key
META_API_KEY=your-meta-key

# Which provider to use: gemini or meta.
# Leave this out to use whichever key is set; Gemini wins when both are.
# VOICE_PROVIDER=gemini
